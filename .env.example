# Copy to .env and adjust. Used by the app and docker compose.

# PostgreSQL connection (host port configurable via DB_HOST_PORT)
DATABASE_URL=postgres://bikenest:bikenest@localhost:5432/bikenest
DB_HOST_PORT=5432

# HTTP bind address
BIND_ADDR=0.0.0.0:8080

# Log filter (tracing env-filter syntax)
RUST_LOG=info

# Object storage (Ledger #7 — S3-compatible; MinIO in dev). See the `S3_*` block
# below. Media is served via direct S3 presigned URLs (no app signing secret).
# MEDIA_ROOT=./media

# Accounts & authentication (M2).
# BASE_URL builds emailed verification/reset links (default http://localhost:8080).
# BASE_URL=http://localhost:8080

# seed-admin (Ledger #10): idempotent, env-driven admin bootstrap.
# Set these, then:  cargo run -p bikenest-web -- seed-admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-at-least-8-chars

# Email provider (generic port, §84): fake | smtp | resend.
# Dev uses smtp → Mailpit (`docker compose up -d mailpit`, UI at :8025).
# Unset falls back to `fake` (in-memory + outbox) so `cargo run` always works.
EMAIL_PROVIDER=smtp
EMAIL_FROM="BikeNest <no-reply@bikenest.local>"
# Mailpit listens on localhost:1025 (no TLS, no auth).
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=1                        # STARTTLS (set for a real relay; Mailpit needs none)
# Resend (EMAIL_PROVIDER=resend):
# RESEND_API_KEY=
# RESEND_FROM=BikeNest <onboarding@resend.dev>

# Fake Google OAuth stub (Ledger #5): deterministic dev identity.
# FAKE_OAUTH_EMAIL=dev.user@example.com
# FAKE_OAUTH_SUB=fake-google-sub-000001

# Optional: separate URL for the test suite (defaults to DATABASE_URL)
# TEST_DATABASE_URL=postgres://bikenest:bikenest@localhost:5432/bikenest

# Privacy & account lifecycle (M6, §75).
# Temporary personal-data export lifetime (hours).
EXPORT_TTL_HOURS=24
# Inactive-account anonymization threshold in days (0 = disabled, config-gated).
# Decision 2026-09-03 (docs/retention-policy.md): stays OFF — accounts live until
# the user deletes them; there is no reminder e-mail yet, so silent anonymization
# would surprise users. The privacy policy says so.
INACTIVE_ACCOUNT_ANONYMIZE_AFTER_DAYS=0
# Deleted-account shell purge threshold in days (0 = disabled, config-gated).
# Decision 2026-09-03: 30 days. The shell holds no personal data after
# anonymization; the purge is housekeeping and matches the privacy policy.
DELETED_ACCOUNT_PURGE_AFTER_DAYS=30
# seed-policies (Ledger #21): version + effective date for the policy_version
# rows. Bump POLICY_VERSION whenever policies/*.md change; the old version is
# kept as history (§70).
# POLICY_VERSION=2026-09-03.1
# POLICY_EFFECTIVE_AT=2026-09-03T00:00:00Z
# seed-policies: controller identity + contact (§70). These fill the {{TOKEN}}s
# in policies/*.md at seed time so the company details never live in the repo.
# The seeder REFUSES to run with any of them missing. The values below are dev
# placeholders — set the real legal entity in production.
POLICY_OPERATOR_NAME="BikeNest Dev Ltda. (DEV PLACEHOLDER)"
POLICY_OPERATOR_CNPJ="00.000.000/0000-00"
POLICY_OPERATOR_ADDRESS="Curitiba, PR, Brasil"
POLICY_CONTACT_EMAIL=privacidade@bikenest.local

# --- M7: configurable tuning constants (defaults = the documented M1/M4/M5/§75 values) ---

# Recommendation weights (Ledger #8, §34). Sub-scores are 0..1; missing input → 0.5.
# REC_WEIGHT_DISTANCE=0.35
# REC_WEIGHT_SECURITY=0.25
# REC_WEIGHT_RATING=0.20
# REC_WEIGHT_FRESHNESS=0.15
# REC_WEIGHT_VERIFICATION=0.05
# REC_CANDIDATE_CAP=500

# Freshness thresholds in days (Ledger #9/#17, §40): fresh | recently verified |
# aging | stale; beyond stale_days → VeryStale. Never verified → Never.
# FRESHNESS_FRESH_DAYS=30
# FRESHNESS_RECENT_DAYS=90
# FRESHNESS_AGING_DAYS=180
# FRESHNESS_STALE_DAYS=365

# Photo pipeline limits (Ledger #18, §30/#44). NOTE: the domain crate keeps these
# as its compile-time enforcement values; these env knobs document the intended
# production values and are wired where plumbing already exists. (Full runtime
# plumbing is tracked in plans/m8-*.md.)
# PHOTO_MAX_BYTES=10485760          # 10 MiB
# PHOTO_MAX_MEGAPIXELS=20
# PHOTO_THUMB_MAX_SIDE=400
# PHOTO_DERIVATIVE_QUALITY=85

# Moderation limits (Ledger #19, §43): max report body length + per-window limits.
# MOD_REPORT_DESC_MAX_LEN=1000
# MOD_REPORT_USER_LIMIT=10
# MOD_REPORT_IP_LIMIT=20

# Retention TTLs in seconds (Ledger #20, §75), each defaulting to the
# RetentionPolicy defaults (1h reset, 24h verification, 30d session, 90d parked,
# 24h export, 24h upload-orphan).
# RETENTION_PASSWORD_RESET_SECONDS=3600
# RETENTION_EMAIL_VERIFICATION_SECONDS=86400
# RETENTION_SESSION_IDLE_SECONDS=2592000
# RETENTION_PARKED_HERE_SECONDS=7776000
# RETENTION_EXPORT_SECONDS=86400
# RETENTION_UPLOAD_ORPHAN_SECONDS=86400

# --- M7: security headers / CSP ---
# TLS_ON=1                          # emit Strict-Transport-Security (set when TLS terminates here)
# CSP_TILE_HOSTS=https://demotiles.maplibre.org   # MapLibre style/tile/glyph origins
# CSP_GEOCODE_HOSTS=                # browser-reachable client-side geocoding origins (empty in dev)
# APP_ENV=development               # "production" → JSON structured logs

# --- Rate limiter (M8, Ledger #6): shared ValKey backend (Redis-compatible) ---
# The app uses a ValKey sliding-window rate limiter for auth/photo/contribution/
# moderation. Without either knob it falls back to a per-process in-memory limiter.
#
# Single node (`ValKeyRateLimiter::single`):
# VALKEY_URL=valkey://localhost:6379
#
# Cluster (comma-separated nodes, `ValKeyRateLimiter::cluster`; wins over VALKEY_URL):
# VALKEY_CLUSTER_URLS=valkey://node1:6379,valkey://node2:6379,valkey://node3:6379
#
# When ValKey is unreachable, fail OPEN (allow) by default so an outage does not
# 429 every rate-limited endpoint. Set to false to fail CLOSED (deny → 429) instead.
# RATE_LIMIT_FAIL_OPEN=true

# --- Geocoder (M8, Ledger #2): mapbox | fake (default fake) ---
# The destination query is resolved server-side. **Only the free-text query is
# sent to the provider** (§77) — no account identity, cookie, or client IP.
# 'mapbox' sends the query to the Mapbox Geocoding API (hosted OSM-derived; §83 —
# provider contract / DPA / international-transfer review applies, see
# docs/provider-transfer-inventory.md).
# GEOCODER=fake
# Set MAPBOX_ACCESS_TOKEN (Mapbox account) when GEOCODER=mapbox.
# MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# --- Map style / tiles (M8, Ledger #3): mapbox or demo tiles ---
# The map (search + details) reads its style / token from <body data-*>, so no
# inline script (CSP-safe). `MAP_STYLE_URL` defaults to MapLibre's public demo
# tiles; set it to a real basemap for production. For a Mapbox style use a
# `mapbox://styles/<user>/<style>` URL (or the HTTPS styles URL); MapLibre then
# needs the public access token embedded client-side (standard for Mapbox).
# Send `MAPBOX_MAP_ACCESS_TOKEN` (a URL-restricted public token) rather than
# reusing the server-only geocoder token if you want to keep them separate; it
# falls back to `MAPBOX_ACCESS_TOKEN` when unset.
# MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# MAPBOX_MAP_ACCESS_TOKEN=pk.your_public_map_token

# --- Object storage (M8, Ledger #7): S3-compatible (MinIO for dev) ---
# The app stores photos/media in an S3-compatible bucket and serves them via
# direct S3 presigned URLs (the browser hits the bucket; the app is not a
# media proxy). Defaults target a local MinIO (docker compose), so `cargo run`
# works against the dev stack; set these below for AWS S3 / Cloudflare R2 /
# Backblaze B2 in production.
# S3_ENDPOINT=http://localhost:9000   # empty -> standard AWS endpoint
# S3_REGION=us-east-1
# S3_BUCKET=bikenest
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- Background jobs (M9, plans/m9-background-jobs.md): Postgres-backed queue ---
# An in-process worker polls a `background_job` table, claims due jobs, runs
# their handler, and records success / retry / dead-letter. All job times are UTC.
# Set `JOBS_ENABLED=false` on web-only instances (or to run jobs elsewhere).
# JOBS_ENABLED=true
# JOBS_POLL_INTERVAL_MS=5000
# JOBS_BATCH_SIZE=4
# JOBS_LEASE_TTL_MS=600000       # lease; a long job heartbeats to hold it
# JOBS_MAX_ATTEMPTS=5            # retry budget before dead-letter
# JOBS_BACKOFF_BASE_MS=2000      # exponential backoff base (x 2^(attempt-1) + jitter)
# JOBS_HISTORY_RETENTION_DAYS=7  # jobs.gc deletes terminal rows older than this

